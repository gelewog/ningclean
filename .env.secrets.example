# Vercel Deployment Secrets
# Add these to GitHub Repository Settings > Secrets and variables > Actions
# URL: https://github.com/gelewog/ningclean/settings/secrets/actions

# ========================================
# 1. VERCEL_TOKEN (Required - get from Vercel Dashboard)
# ========================================
# Go to: https://vercel.com/account/tokens
# Click "Create Token", give it a name, copy the value
VERCEL_TOKEN=

# ========================================
# 2. VERCEL_ORG_ID (Auto-detected)
# ========================================
VERCEL_ORG_ID=team_WX6sW6O6ij5OHUHMSnt2LQmu

# ========================================
# 3. Project IDs (Auto-detected from .vercel/project.json)
# ========================================
VERCEL_API_PROJECT_ID=prj_G8QUgfuy3ZJXWvJDE8fBY0vXJhOv
VERCEL_ADMIN_PROJECT_ID=prj_odScQdJfDzFKiGsqviBwHnkPlj8l
VERCEL_WEB_PROJECT_ID=prj_YxxSD1wLrzNUADSdQbSUo5PB7Jou

# ========================================
# 4. NEXT_PUBLIC_API_URL (Your production API URL)
# ========================================
# This should be the URL of your deployed API
# Example: https://ningclean-api.vercel.app
NEXT_PUBLIC_API_URL=https://ningclean-api.vercel.app
