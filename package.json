{
  "name": "@ningclean/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:full": "concurrently -n WEB,API,ADMIN -c blue,green,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "build": "npm run build --workspace=@ningclean/web",
    "build:admin": "cd apps/admin && npm run build",
    "lint": "npm run lint --workspace=@ningclean/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.0.0"
  }
}