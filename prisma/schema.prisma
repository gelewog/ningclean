generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  BOOKING_NEW
  BOOKING_STATUS
  SYSTEM
}

enum TemplateType {
  BOOKING_CONFIRMED
  BOOKING_STATUS_UPDATED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  CUSTOMER_WELCOME
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      Role     @default(ADMIN)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  isVip       Boolean  @default(false)
  notes       String?  @db.Text
  addresses   Json     @default("[]")
  source      String   @default("guest")
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@map("customers")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  category    String   @default("general")
  image       String?
  icon        String?
  features    String[] @default([])
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingItems BookingItem[]
  galleryItems GalleryItem[]

  @@map("services")
}

model Booking {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  customerId    String?
  status        BookingStatus @default(PENDING)
  serviceDate   DateTime
  serviceTime   String
  address       String
  area          String
  notes         String?
  internalNotes String?
  totalAmount   Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  items    BookingItem[]

  guestName    String?
  guestEmail   String?
  guestPhone   String?

  @@map("bookings")
}

model BookingItem {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("booking_items")
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   @db.Text
  coverImage  String?
  author      String
  categoryId  String?
  publishedAt DateTime @default(now())
  tags        String[]
  readTime    Int
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model BlogCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

model Testimonial {
  id         String   @id @default(uuid())
  name       String
  role       String?
  company    String?
  content    String   @db.Text
  rating     Int      @default(5)
  avatar     String?
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  position    String
  department  String
  bio         String?  @db.Text
  avatar      String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model CompanyStat {
  id          String   @id @default(uuid())
  title       String
  value       String
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_stats")
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  category    String
  imageUrl    String
  beforeImage String?
  afterImage  String?
  location    String?
  serviceId   String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id])

  @@map("gallery_items")
}

model FAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String   @db.Text
  category    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model ServiceArea {
  id          String   @id @default(uuid())
  city        String
  slug        String   @unique
  region      String
  description String?  @db.Text
  coverage    String[]
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_areas")
}

model JobListing {
  id           String   @id @default(uuid())
  title        String
  department   String
  location     String
  type         String
  description  String   @db.Text
  requirements String[]
  benefits     String[]
  salaryRange  String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("job_listings")
}

model PricingPlan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String
  price        Decimal  @db.Decimal(10, 2)
  billingCycle String
  features     String[]
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pricing_plans")
}

model NotificationSettings {
  id      String @id @default(uuid())
  name    String @unique @default("default")  // Identifier untuk settings (default, production, dll)
  config  Json   @default("{}")              // Semua pengaturan: whatsapp, email, twilio, dll
  secrets Json?                              // Secrets terpisah: twilioAuthToken, emailPassword, dll
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @default(BOOKING_NEW)
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@map("notifications")
}

model SiteSettings {
  id                String   @id @default(uuid())
  companyName       String   @default("NingClean")
  tagline           String?
  description       String?
  logo              String?
  favicon           String?
  logoDark          String?
  email             String?
  phone             String?
  whatsapp          String?
  address           String?
  city              String?
  province          String?
  postalCode        String?
  googleMapsUrl     String?
  facebook          String?
  instagram         String?
  twitter           String?
  youtube           String?
  linkedin          String?
  tiktok            String?
  metaTitle         String?
  metaDescription   String?
  ogImage           String?
  keywords          String?
  footerText        String?
  copyrightText     String?
  mondayOpen        String   @default("08:00")
  mondayClose       String   @default("18:00")
  tuesdayOpen       String   @default("08:00")
  tuesdayClose      String   @default("18:00")
  wednesdayOpen     String   @default("08:00")
  wednesdayClose    String   @default("18:00")
  thursdayOpen      String   @default("08:00")
  thursdayClose     String   @default("18:00")
  fridayOpen        String   @default("08:00")
  fridayClose       String   @default("18:00")
  saturdayOpen      String   @default("09:00")
  saturdayClose     String   @default("17:00")
  sundayOpen        String   @default("09:00")
  sundayClose       String   @default("15:00")
  is24Hours         Boolean  @default(false)
  minAdvanceDays    Int      @default(1)
  maxAdvanceDays    Int      @default(30)
  cancellationHours Int      @default(24)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}

model NavigationSettings {
  id                   String   @id @default(uuid())
  navLinks             Json     @default("[]")
  showServicesDropdown Boolean  @default(true)
  servicesDropdownLabel String  @default("Layanan")
  ctaButtonText        String   @default("Booking")
  ctaButtonLink        String   @default("/booking")
  showCtaButton        Boolean  @default(true)
  mobileMenuType       String   @default("slide")
  activeIndicatorStyle String   @default("dot")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("navigation_settings")
}

model HomepageSettings {
  id                      String   @id @default(uuid())
  heroHeadline            String   @default("Transformasi Rumah Anda")
  heroSubheadline         String   @default("Layanan kebersihan profesional dengan tim tersertifikasi. Hasil nyata yang bisa kamu lihat langsung.")
  heroImage               String?
  heroBadge               String   @default("Dipercaya 1250+ Pelanggan")
  ctaPrimaryText          String   @default("Booking Sekarang")
  ctaPrimaryLink          String   @default("/booking")
  ctaSecondaryText        String   @default("Lihat Layanan & Paket")
  ctaSecondaryLink        String   @default("/services")
  statsHomesCleaned       String   @default("1250+")
  statsRating             String   @default("4.95")
  statsSatisfaction       String   @default("99%")
  statsResponseTime       String   @default("< 30m")
  showFeaturesSection     Boolean  @default(true)
  showServicesSection     Boolean  @default(true)
  showTestimonialsSection Boolean  @default(true)
  showAreasSection        Boolean  @default(true)
  showBlogSection         Boolean  @default(true)
  showImageShowcase       Boolean  @default(true)
  showCTASection          Boolean  @default(true)
  featuredServiceIds      Json     @default("[]")
  beforeAfterSlides       Json     @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("homepage_settings")
}

model FooterSettings {
  id                 String   @id @default(uuid())
  footerColumns      Json     @default("[]")
  showContact        Boolean  @default(true)
  contactEmail       String?
  contactPhone       String?
  contactWhatsapp    String?
  contactAddress     String?
  showSocials        Boolean  @default(true)
  socialLinks        Json     @default("[]")
  showNewsletter     Boolean  @default(true)
  newsletterTitle    String   @default("Dapat tips bersih setiap minggu")
  newsletterSubtitle String?
  showStatusBadge    Boolean  @default(true)
  statusBadgeText    String   @default("Semua layanan aktif")
  copyrightText      String   @default("All rights reserved.")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("footer_settings")
}

model EmailTemplate {
  id        String       @id @default(uuid())
  type      TemplateType @unique
  name      String
  subject   String
  body      String
  smsBody   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("email_templates")
}

model InvoiceTemplate {
  id             String   @id @default(uuid())
  name           String   @default("Default")
  headerText     String   @default("INVOICE")
  companyName    String   @default("NingClean")
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  companyLogo    String?
  footerText     String?
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  notes          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("invoice_templates")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  userId     String?
  userEmail  String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
