{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && cd apps/api && npm run build"
  },
  "deploy": {
    "startCommand": "cd apps/api && npm run start:prod",
    "healthcheckPath": "/api/",
    "healthcheckTimeout": 100
  }
}
