{
  "version": 2,
  "buildCommand": "cd apps/api && npm install && npx prisma generate && npm run build",
  "outputDirectory": "apps/api/dist",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "apps/api/api/index.ts": {
      "maxDuration": 30
    }
  }
}
