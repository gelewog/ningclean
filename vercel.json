{
  "version": 2,
  "name": "ningclean-admin",
  "builds": [
    {
      "src": "apps/admin/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/admin/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.ningclean.com/api"
  }
}
